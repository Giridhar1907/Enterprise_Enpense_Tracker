rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User collection rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Expense collection rules
    match /expenses/{expenseId} {
      // Employees can read their own expenses
      // Managers and Admins can read all expenses (or filtered by org in a real app)
      allow read: if request.auth != null && (
        resource.data.employeeId == request.auth.uid ||
        getUserData().role == 'MANAGER' ||
        getUserData().role == 'ADMIN'
      );

      // Employees can create expenses
      allow create: if request.auth != null && request.resource.data.employeeId == request.auth.uid;

      // Managers can update status and remarks
      // Employees can update their own expenses if they are still PENDING
      allow update: if request.auth != null && (
        (getUserData().role == 'MANAGER' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalRemarks', 'approvedBy', 'managerName'])) ||
        (resource.data.employeeId == request.auth.uid && resource.data.status == 'PENDING')
      );

      allow delete: if request.auth != null && resource.data.employeeId == request.auth.uid && resource.data.status == 'PENDING';
    }
  }
}
